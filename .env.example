# reel-listing / VistaFlow -- environment reference.
# Copy to .env for local development. In Coolify these are set in the UI.
#
# IMPORTANT: every VITE_* variable is inlined into the browser bundle at BUILD time.
# Setting them at container runtime has no effect -- pass them as Docker build args
# (Coolify: "Build Variables", not "Environment Variables").

# ---- Core ----------------------------------------------------------------
NODE_ENV=production
PORT=3000
# The stable public origin. Used to build the fal.ai render callback URL, which is read at
# module load. Unset, it defaults to https://reel-listing.com and every render job on a new
# host registers its webhook against the OLD domain, so renders never advance.
PUBLIC_URL=https://your-domain.com

# ---- Database ------------------------------------------------------------
# Postgres. On self-hosted Supabase this is the direct connection string.
DATABASE_URL=postgres://user:password@host:5432/postgres

# ---- Supabase (auth + storage) -------------------------------------------
# Server-side.
SUPABASE_URL=https://supabase.your-domain.com
SUPABASE_ANON_KEY=
# Client-side. BUILD ARGS.
VITE_SUPABASE_URL=https://supabase.your-domain.com
VITE_SUPABASE_ANON_KEY=

# ---- Paddle --------------------------------------------------------------
# sandbox | production. Sandbox and live are entirely separate Paddle accounts: different
# API keys, client tokens, webhook secrets AND price IDs. Going live is a whole env set,
# not one flag. The server refuses to boot on a sandbox key with PADDLE_ENVIRONMENT=production.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
# From the notification destination in Paddle, not the API key. Each destination has its own.
PADDLE_WEBHOOK_SECRET=
# Paddle price IDs (pri_...). A plan with no price ID set is hidden from the pricing page
# rather than rendering a button that cannot work.
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_AGENCY=
PADDLE_PRICE_PACK_LISTING5=
# Client-side. BUILD ARGS. This is the CLIENT token (test_... / live_...), never the API key.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox

# ---- fal.ai (video + vision) ---------------------------------------------
FAL_KEY=

# ---- Optional ------------------------------------------------------------
# Grants the admin role to the matching users.openId on sign-in.
OWNER_OPEN_ID=
# Signs the legacy Manus OAuth session cookie. Not needed when using Supabase auth.
JWT_SECRET=
# Legacy Manus platform integrations. Leave unset when self-hosting: storage then uses
# Supabase Storage, which is the path the app already runs on.
OAUTH_SERVER_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_APP_ID=
# Distributed rate limiting. Unset, the app falls back to an in-process limiter, which is
# correct for a single container.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Umami analytics. BUILD ARGS. Unset, client/index.html emits an inert placeholder tag.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
