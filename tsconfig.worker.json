{
  "include": ["server/**/*", "shared/**/*", "drizzle/schema.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo.worker",
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "lib": ["esnext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "@cloudflare/vitest-pool-workers/types"],
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  }
}
